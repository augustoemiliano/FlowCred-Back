PROJECT_NAME=FlowCred API
PROJECT_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Vazio = SQLite em ./db.local (dev local).
# No Docker, o compose define sqlite:////app/data/db.local (volume flowcred_data).
DATABASE_URL=

# Opcional: Postgres (só é usado se DATABASE_URL estiver vazio e SERVER/DB/USER preenchidos).
POSTGRES_SERVER=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Origens autorizadas (separadas por vírgula): Vite dev (5173), vite preview (4173) e front em Docker (8080).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8080

# Obrigatório, mínimo 16 caracteres. Em produção gere um valor aleatório, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ensure_admin / entrypoint criam ou sincronizam este utilizador administrador.
# Apenas para desenvolvimento: admin/admin é fraco; altere em produção.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin

# 1 = cria cliente CPF 52998224725 + 1 proposta demo (idempotente). Use 0 em produção.
SEED_DEV_DATA=1

# Diretório dos uploads (dev local: ./uploads; no Docker o compose define /app/uploads).
UPLOAD_DIR=./uploads
# Limite por arquivo, em bytes (10 MB).
MAX_UPLOAD_BYTES=10485760
